# Copy to .env locally. Never commit real values.
NODE_ENV=development
PORT=8787

# Telegram app credentials from https://my.telegram.org/apps.
TG_API_ID=your_numeric_api_id
TG_API_HASH=your_api_hash

# Separate long password for opening the private web client.
APP_PASSWORD=replace_with_a_long_random_password

# Generate with: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=replace_with_64_hex_characters

# Exact frontend origins, comma-separated. Set the final Pages origin later.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8787

# Optional encrypted session storage in Cloudflare R2.
# Set ALL four values to enable R2, or leave ALL four empty to use local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
