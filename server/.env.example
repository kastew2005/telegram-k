# Copy to .env locally. Never commit real values.
NODE_ENV=development
PORT=8787
DATA_DIR=./data

# From https://my.telegram.org/apps — keep these private.
TG_API_ID=your_numeric_api_id
TG_API_HASH=your_api_hash

# Choose a long, unique password to unlock your private web app.
APP_PASSWORD=replace_with_a_long_random_password

# Generate with: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=replace_with_64_hex_characters

# Comma-separated exact frontend origins. Add the deployed Pages origin later.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8787
